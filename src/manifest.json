{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDesc__",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.leboncoin.fr/*",
    "https://*.lefigaro.fr/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_extensionName__"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.leboncoin.fr/*",
        "https://*.immobilier.lefigaro.fr/*",
        "https://immobilier.lefigaro.fr/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@immo-boussole.local",
      "strict_min_version": "109.0"
    }
  }
}
