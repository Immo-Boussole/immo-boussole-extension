{
  "name": "immo-boussole-extension",
  "version": "1.0.0",
  "description": "Browser extension for Firefox, Chrome, and Edge to submit listings to Immo-Boussole",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:firefox": "tsc && vite build --mode firefox",
    "build:chrome": "tsc && vite build --mode chrome",
    "package": "node scripts/package.js"
  },
  "dependencies": {
    "webextension-polyfill": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/webextension-polyfill": "^0.10.7",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  }
}
